---
interface Props {
	date: Date;
	compact?: boolean;
}

const { date, compact = false } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		compact
			? date.toLocaleDateString('pt-BR', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
				})
			: date.toLocaleDateString('pt-BR', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				})
	}
</time>
