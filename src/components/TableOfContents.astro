---
interface Props {
    headings?: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="toc" aria-label="Neste artigo" data-toc>
    <p class="toc-title">Neste artigo</p>
    <nav>
        <ul data-toc-list>
            {toc.map((h) => (
                <li class={`toc-item toc-depth-${h.depth}`}>
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
                </li>
            ))}
        </ul>
    </nav>
</aside>

<style>
    .toc {
        display: none;
    }
    .toc[data-empty="true"] {
        display: none !important;
    }
    @media (min-width: 1024px) {
        .toc:not([data-empty="true"]) {
            display: block;
            position: sticky;
            top: 6rem;
            align-self: start;
            max-height: calc(100vh - 8rem);
            overflow-y: auto;
            padding: 1.25rem 1rem 1.25rem 0;
            border-left: 1px solid var(--border);
            font-size: 0.85rem;
        }
        .toc-title {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted-foreground);
            margin: 0 0 0.75rem 1rem;
        }
        .toc ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .toc-item a {
            display: block;
            padding: 0.3rem 0 0.3rem 1rem;
            color: var(--muted-foreground);
            text-decoration: none;
            border-left: 2px solid transparent;
            margin-left: -1px;
            transition: color 0.15s ease, border-color 0.15s ease;
            line-height: 1.4;
        }
        .toc-item a:hover {
            color: var(--foreground);
        }
        .toc-item a.toc-active {
            color: var(--primary);
            border-left-color: var(--primary);
        }
        .toc-depth-3 a {
            padding-left: 2rem;
            font-size: 0.8rem;
        }
    }
</style>

<script is:inline defer src="/scripts/toc.js"></script>
