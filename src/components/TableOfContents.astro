---
interface Props {
    headings?: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="toc" aria-label="Neste artigo" data-toc>
    <p class="toc-title">Neste artigo</p>
    <nav>
        <ul data-toc-list>
            {toc.map((h) => (
                <li class={`toc-item toc-depth-${h.depth}`}>
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
                </li>
            ))}
        </ul>
    </nav>
</aside>

<style>
    .toc {
        display: none;
    }
    .toc[data-empty="true"] {
        display: none !important;
    }
    @media (min-width: 1024px) {
        .toc:not([data-empty="true"]) {
            display: block;
            position: sticky;
            top: 6rem;
            align-self: start;
            max-height: calc(100vh - 8rem);
            overflow-y: auto;
            padding: 1.25rem 1rem 1.25rem 0;
            border-left: 1px solid var(--border);
            font-size: 0.85rem;
        }
        .toc-title {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted-foreground);
            margin: 0 0 0.75rem 1rem;
        }
        .toc ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .toc-item a {
            display: block;
            padding: 0.3rem 0 0.3rem 1rem;
            color: var(--muted-foreground);
            text-decoration: none;
            border-left: 2px solid transparent;
            margin-left: -1px;
            transition: color 0.15s ease, border-color 0.15s ease;
            line-height: 1.4;
        }
        .toc-item a:hover {
            color: var(--foreground);
        }
        .toc-item a.toc-active {
            color: var(--primary);
            border-left-color: var(--primary);
        }
        .toc-depth-3 a {
            padding-left: 2rem;
            font-size: 0.8rem;
        }
    }
</style>

<script is:inline>
    (function () {
        // TOC funciona sem `headings` do SSR (glob loader retorna []):
        // gera slugs para h2/h3 de #prose-content que não têm id, monta a lista e observa.
        function slugify(text) {
            return text
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9\s-]/g, "")
                .trim()
                .replace(/[\s_]+/g, "-")
                .replace(/-+/g, "-");
        }
        var aside = document.querySelector("[data-toc]");
        var list = document.querySelector("[data-toc-list]");
        if (!aside || !list) return;
        var prose = document.getElementById("prose-content");
        var heads = prose ? prose.querySelectorAll("h2, h3") : [];
        var seen = {};
        // Se o SSR já renderizou itens, apenas garante ids nos headings.
        if (list.children.length > 0) {
            heads.forEach(function (h) {
                if (!h.id) {
                    var base = slugify(h.textContent || "secao") || "secao";
                    var n = seen[base] = (seen[base] || 0) + 1;
                    h.id = n > 1 ? base + "-" + n : base;
                }
            });
        } else {
            heads.forEach(function (h) {
                var base = slugify(h.textContent || "secao") || "secao";
                var n = seen[base] = (seen[base] || 0) + 1;
                var id = h.id || (n > 1 ? base + "-" + n : base);
                h.id = id;
                var li = document.createElement("li");
                li.className = "toc-item toc-depth-" + (h.tagName === "H3" ? 3 : 2);
                var a = document.createElement("a");
                a.href = "#" + id;
                a.setAttribute("data-toc-link", id);
                a.textContent = h.textContent;
                li.appendChild(a);
                list.appendChild(li);
            });
        }
        if (list.children.length === 0) {
            aside.setAttribute("data-empty", "true");
            return;
        }
        var links = list.querySelectorAll("[data-toc-link]");
        if (!("IntersectionObserver" in window)) return;
        var map = {};
        links.forEach(function (a) {
            map[a.getAttribute("data-toc-link")] = a;
        });
        var obs = new IntersectionObserver(
            function (entries) {
                entries.forEach(function (e) {
                    var a = map[e.target.id];
                    if (!a) return;
                    if (e.isIntersecting) {
                        links.forEach(function (l) { l.classList.remove("toc-active"); });
                        a.classList.add("toc-active");
                    }
                });
            },
            { rootMargin: "-20% 0px -70% 0px" },
        );
        Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id);
            if (el) obs.observe(el);
        });
    })();
</script>
