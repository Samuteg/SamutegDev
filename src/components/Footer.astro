---
import { AUTHOR, SITE_DESCRIPTION, SOCIAL_LINKS } from "../consts";

const today = new Date();
---

<footer class="mt-auto border-t border-border px-6 py-12 max-md:px-4 max-md:py-8">
    <div class="mx-auto flex max-w-3xl flex-col gap-8">
        <div class="flex flex-wrap items-start justify-between gap-6">
            <div class="flex flex-col gap-2">
                <div class="font-display text-lg font-bold tracking-tight">{AUTHOR}</div>
                <p class="m-0 max-w-xs text-sm text-muted-foreground">{SITE_DESCRIPTION}</p>
                <p class="m-0 font-mono text-xs uppercase tracking-widest text-muted-foreground opacity-80">
                    &copy; {today.getFullYear()} &middot; Construído com Astro
                </p>
            </div>

            <nav class="flex flex-col gap-3" aria-label="Navegação do rodapé">
                <a class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground opacity-80 transition-colors hover:text-primary hover:opacity-100" href="/">Início</a>
                <a class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground opacity-80 transition-colors hover:text-primary hover:opacity-100" href="/blog">Blog</a>
                <a class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground opacity-80 transition-colors hover:text-primary hover:opacity-100" href="/about">Sobre</a>
                <a class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground opacity-80 transition-colors hover:text-primary hover:opacity-100" href="/rss.xml">RSS</a>
            </nav>

            <div class="flex gap-3">
                <a
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
                    href={SOCIAL_LINKS.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub"
                >
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <path
                            fill="currentColor"
                            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>
