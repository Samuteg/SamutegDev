---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ShareButtons from "../components/ShareButtons.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { SITE_URL, AUTHOR_URL, AUTHOR, SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"] & {
    id?: string;
    headings?: MarkdownHeading[];
    related?: CollectionEntry<"blog">[];
};

const { id, title, description, pubDate, updatedDate, heroImage, headings = [], related = [] } = Astro.props as Props;
const tags = (Astro.props as Props & { tags?: string[] }).tags ?? [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const heroURL = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;

const blogPostingJSON = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    ...(updatedDate && { dateModified: updatedDate.toISOString() }),
    ...(heroURL && { image: heroURL }),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
    url: canonicalURL,
    inLanguage: "pt-BR",
    author: { "@type": "Person", name: AUTHOR, url: AUTHOR_URL },
    publisher: {
        "@type": "Person",
        name: AUTHOR,
        url: SITE_URL,
    },
    isPartOf: {
        "@type": "Blog",
        name: SITE_TITLE,
        url: SITE_URL,
    },
});
---

<BaseLayout
    title={title}
    description={description}
    image={heroImage}
    ogType="article"
    publishedTime={pubDate}
    modifiedTime={updatedDate}
>
    <script is:inline type="application/ld+json" set:html={blogPostingJSON} slot="head" />
    <div class="mx-auto w-full max-w-3xl">
        <div class="mb-10">
            <a href="/blog" class="inline-flex items-center justify-center rounded-full border border-input bg-background px-4 py-2 font-mono text-[0.7rem] uppercase tracking-widest no-underline transition-colors hover:bg-accent hover:text-accent-foreground">
                ← Voltar
            </a>
        </div>

        <div class="post-layout">
            <article>
                <div class="mb-10">
                    <div class="mb-5 flex items-center gap-3 text-muted-foreground">
                        <span class="font-mono text-xs uppercase tracking-widest">
                            <FormattedDate date={pubDate} />
                        </span>
                        <span class="opacity-50">•</span>
                        <span class="font-mono text-xs uppercase tracking-widest" id="reading-time">Leitura</span>
                    </div>
                    <h1 class="m-0 font-display text-4xl font-extrabold leading-[1.15] tracking-tight md:text-5xl" style={`view-transition-name: title-${id}`}>
                        {title}
                    </h1>
                    {
                        updatedDate && (
                            <div class="mt-3 font-mono text-xs uppercase tracking-widest text-muted-foreground opacity-80">
                                Atualizado em <FormattedDate date={updatedDate} />
                            </div>
                        )
                    }
                    {tags.length > 0 && (
                        <div class="mt-5 flex flex-wrap gap-1.5">
                            {tags.map((tag) => (
                                <a class="rounded-full border border-border bg-muted px-2.5 py-1 font-mono text-[0.7rem] tracking-wide text-muted-foreground no-underline transition-colors hover:border-primary hover:text-primary" href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>
                            ))}
                        </div>
                    )}
                </div>

                {
                    heroImage && (
                        <div class="mb-10 overflow-hidden rounded-2xl border border-border">
                            <Image
                                width={1020}
                                height={510}
                                src={heroImage}
                                alt=""
                                style={`view-transition-name: img-${id}`}
                                class="block h-auto w-full"
                            />
                        </div>
                    )
                }

                <div class="prose max-w-none text-foreground" id="prose-content">
                    <slot />
                </div>

                <ShareButtons title={title} />
            </article>

            <TableOfContents headings={headings} />
        </div>

        <RelatedPosts posts={related} />
    </div>

    <script is:inline slot="head" src="/scripts/reading-time.js"></script>

    <style slot="head">
        /* ── Blog post: article-5 two-column with sticky TOC ── */
        :global(main) {
            max-width: 1080px;
            padding: 3rem 1.5rem 5rem;
        }

        .post-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
            align-items: start;
        }

        @media (min-width: 1024px) {
            .post-layout:has(.toc nav ul li) {
                grid-template-columns: minmax(0, 720px) 240px;
                justify-content: center;
            }
        }

        /* ── Prose (Rich content) ── */
        .prose {
            color: var(--foreground);
            line-height: 1.7;
            font-size: 1.1rem;
        }

        .prose :global(h2) {
            margin-top: 3rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            font-family: var(--font-display);
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            border-bottom: 1px solid var(--border);
            color: var(--foreground);
        }

        .prose :global(h3) {
            margin-top: 2rem;
            margin-bottom: 0.75rem;
            font-family: var(--font-display);
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--foreground);
        }

        .prose :global(p) {
            color: var(--foreground);
        }

        .prose :global(a) {
            color: var(--primary);
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .prose :global(ul),
        .prose :global(ol) {
            padding-left: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .prose :global(li) {
            margin-bottom: 0.5rem;
        }

        .prose :global(strong) {
            color: var(--foreground);
            font-weight: 600;
        }

        .prose :global(table) {
            width: 100%;
            border-collapse: collapse;
            margin: 2rem 0;
            font-size: 0.95rem;
        }

        .prose :global(th) {
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--foreground);
        }

        .prose :global(td) {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--muted-foreground);
        }

        .prose :global(code) {
            font-family: var(--font-mono);
            font-size: 0.85em;
            padding: 0.2rem 0.4rem;
            background-color: var(--muted);
            color: var(--foreground);
            border: 1px solid var(--border);
            border-radius: 4px;
        }

        .prose :global(blockquote) {
            border-left: 2px solid var(--primary);
            padding: 0.5rem 1.5rem;
            margin: 2rem 0;
            color: var(--muted-foreground);
            background: color-mix(in srgb, var(--primary) 8%, transparent);
        }

        .prose :global(blockquote p) {
            margin-bottom: 0;
        }

        @media (max-width: 768px) {
            :global(main) {
                padding: 1.5rem 1rem 3rem;
            }
            .prose {
                font-size: 1rem;
            }
        }
    </style>
</BaseLayout>
