---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & { id?: string };

const { id, title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
    <div class="post-container">
        <div class="back-link-wrapper fade-in-up">
            <a href="/blog" class="back-link btn-pill btn-pill-ghost">
                ← Voltar
            </a>
        </div>

        <article class="fade-in-up delay-1">
            <div class="title-section">
                <div class="post-meta">
                    <span class="label-caps">
                        <FormattedDate date={pubDate} />
                    </span>
                    <span class="meta-separator">•</span>
                    <span class="label-caps" id="reading-time">Leitura</span>
                </div>
                <h1 class="post-title" style={`view-transition-name: title-${id}`}>
                    {title}
                </h1>
                {
                    updatedDate && (
                        <div class="last-updated label-caps">
                            Atualizado em <FormattedDate date={updatedDate} />
                        </div>
                    )
                }
            </div>

            {
                heroImage && (
                    <div class="hero-image">
                        <Image
                            width={1020}
                            height={510}
                            src={heroImage}
                            alt=""
                            style={`view-transition-name: img-${id}`}
                        />
                    </div>
                )
            }

            <div class="prose" id="prose-content">
                <slot />
            </div>
        </article>
    </div>

    <script is:inline slot="head" src="/scripts/reading-time.js"></script>

    <style slot="head">
        /* ── Blog post: 720px reading column (per DESIGN.md) ── */
        :global(main) {
            max-width: 720px;
            padding: 3rem 1.5rem 5rem;
        }

        .post-container {
            width: 100%;
        }

        .back-link-wrapper {
            margin-bottom: 2.5rem;
        }
        .back-link {
            font-size: 0.7rem;
            padding: 0.5rem 1rem;
        }

        article {
            background-color: transparent;
        }

        .title-section {
            margin-bottom: 2.5rem;
        }

        .post-meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
            color: var(--text-muted);
        }
        .meta-separator {
            color: var(--text-muted);
            opacity: 0.5;
        }

        .post-title {
            font-family: var(--font-display);
            font-size: clamp(2rem, 5vw, 2.5rem);
            margin: 0;
            line-height: 1.15;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text-color);
        }

        .last-updated {
            margin-top: 0.75rem;
            color: var(--text-muted);
            opacity: 0.8;
        }

        .hero-image {
            width: 100%;
            margin-bottom: 2.5rem;
            border-radius: var(--border-radius-xl);
            overflow: hidden;
            border: 1px solid var(--glass-border);
        }
        .hero-image img {
            width: 100%;
            height: auto;
            display: block;
            border: none;
            border-radius: 0;
        }

        /* ── Prose (Rich content) ── */
        .prose {
            color: var(--text-color);
            line-height: 1.7;
            font-size: 1.1rem;
        }

        .prose :global(h2) {
            margin-top: 3rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            font-family: var(--font-display);
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            border-bottom: 1px solid var(--glass-border);
        }

        .prose :global(h3) {
            margin-top: 2rem;
            margin-bottom: 0.75rem;
            font-family: var(--font-display);
            font-size: 1.3rem;
            font-weight: 600;
        }

        .prose :global(a) {
            color: var(--accent-color);
            text-decoration: underline;
            text-decoration-color: var(--accent-subtle);
            text-underline-offset: 4px;
            transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
        }

        .prose :global(a:hover) {
            color: var(--accent-hover);
            text-decoration-color: var(--accent-color);
        }

        .prose :global(ul),
        .prose :global(ol) {
            padding-left: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .prose :global(li) {
            margin-bottom: 0.5rem;
        }

        .prose :global(strong) {
            color: var(--text-color);
            font-weight: 600;
        }

        .prose :global(table) {
            width: 100%;
            border-collapse: collapse;
            margin: 2rem 0;
            font-size: 0.95rem;
        }

        .prose :global(th) {
            border-bottom: 1px solid var(--glass-border);
            padding: 0.75rem 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-color);
        }

        .prose :global(td) {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--glass-border);
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            :global(main) {
                padding: 1.5rem 1rem 3rem;
            }
            .prose {
                font-size: 1rem;
            }
        }
    </style>
</BaseLayout>
