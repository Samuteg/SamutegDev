---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
const post = Astro.props;
const { Content, headings } = await render(post);

// Nota: `render()` não retorna headings com o `glob` loader (Astro 7).
// O TableOfContents monta via scan do DOM (#prose-content h2/h3) com slugs gerados em cliente.

const allPosts = await getCollection('blog');
const postTags: string[] = (post.data as { tags?: string[] }).tags ?? [];
const related = allPosts
	.filter((p) => p.id !== post.id)
	.map((p) => ({
		post: p,
		score: ((p.data as { tags?: string[] }).tags ?? []).filter((t: string) => postTags.includes(t)).length,
	}))
	.sort(
		(a, b) =>
			b.score - a.score ||
			b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf(),
	)
	.slice(0, 3)
	.map(({ post }) => post);
---

<BlogPost id={post.id} headings={headings} related={related} {...post.data}>
	<Content />
</BlogPost>
