---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const activeTag = Astro.url.searchParams.get("tag");
const tagsOf = (p: (typeof allPosts)[number]): string[] => (p.data as { tags?: string[] }).tags ?? [];
const allTags = [...new Set(allPosts.flatMap((p) => tagsOf(p)))].sort();
const posts = activeTag ? allPosts.filter((p) => tagsOf(p).includes(activeTag)) : allPosts;
---

<BaseLayout
    title={`Blog | ${SITE_TITLE}`}
    description={SITE_DESCRIPTION}
>
    <div class="mx-auto w-full max-w-7xl px-4 lg:px-8 xl:px-16">
        <section class="max-w-3xl py-16 md:py-24">
            <p class="mb-4 font-mono text-xs uppercase tracking-widest text-primary">Escritos</p>
            <h1 class="m-0 mb-8 font-display text-4xl font-extrabold tracking-tight md:text-6xl">
                Todos os <span class="text-primary">artigos</span>
            </h1>
            <p class="m-0 mb-8 max-w-2xl text-lg leading-relaxed text-muted-foreground">
                Ensaios, tutoriais e explorações na interseção entre tecnologia,
                design e experiência humana.
            </p>
            <nav class="flex flex-wrap gap-2" aria-label="Filtrar por tag" data-tag-nav>
                <a
                    href="/blog"
                    data-tag-filter=""
                    class={`inline-flex items-center rounded-full border border-input px-3.5 py-1.5 font-mono text-xs tracking-wide no-underline transition-colors ${!activeTag ? "bg-primary border-primary text-primary-foreground" : "text-muted-foreground hover:border-primary hover:text-primary"}`}
                >
                    Todos
                </a>
                {allTags.map((tag) => (
                    <a
                        href={`/blog?tag=${encodeURIComponent(tag)}`}
                        data-tag-filter={tag}
                        class={`inline-flex items-center rounded-full border border-input px-3.5 py-1.5 font-mono text-xs tracking-wide no-underline transition-colors ${activeTag === tag ? "bg-primary border-primary text-primary-foreground" : "text-muted-foreground hover:border-primary hover:text-primary"}`}
                        aria-current={activeTag === tag ? "true" : undefined}
                    >
                        {tag}
                    </a>
                ))}
            </nav>
        </section>

        <section class="mb-32">
            <p class="mb-4 font-mono text-xs uppercase tracking-widest text-muted-foreground" data-tag-status role="status" aria-live="polite"></p>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" data-posts-grid>
                {posts.map((post) => (
                    <a
                        href={`/blog/${post.id}/`}
                        data-post-card
                        data-post-tags={tagsOf(post).join(",")}
                        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card no-underline transition-colors hover:border-primary"
                    >
                        <div class="aspect-video overflow-hidden bg-muted">
                            {post.data.heroImage && (
                                <Image
                                    width={600}
                                    height={400}
                                    src={post.data.heroImage}
                                    alt={post.data.title}
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                />
                            )}
                        </div>
                        <div class="p-6">
                            <div class="mb-3 flex items-center gap-4 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                                <span class="text-primary">Artigo</span>
                                <span class="opacity-50">•</span>
                                <FormattedDate date={post.data.pubDate} compact />
                            </div>
                            <h2 class="m-0 mb-3 line-clamp-2 text-lg font-semibold leading-snug transition-colors group-hover:text-primary">
                                {post.data.title}
                            </h2>
                            <p class="m-0 mb-3 line-clamp-2 text-[0.95rem] text-muted-foreground">{post.data.description}</p>
                            {tagsOf(post).length > 0 && (
                                <div class="flex flex-wrap gap-1.5">
                                    {tagsOf(post).map((tag: string) => (
                                        <span class="rounded-full border border-border bg-muted px-2 py-0.5 font-mono text-[0.7rem] tracking-wide text-muted-foreground">{tag}</span>
                                    ))}
                                </div>
                            )}
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </div>

    <script is:inline>
        // SSG-safe tag filter: the static HTML always contains ALL posts;
        // this enhances ?tag= client-side (Astro.url.searchParams is empty at build time).
        (function () {
            var params = new URLSearchParams(window.location.search);
            var active = params.get("tag");
            if (!active) return;
            var grid = document.querySelector("[data-posts-grid]");
            var status = document.querySelector("[data-tag-status]");
            if (!grid) return;
            var cards = Array.from(grid.querySelectorAll("[data-post-card]"));
            var visible = 0;
            cards.forEach(function (card) {
                var tags = (card.getAttribute("data-post-tags") || "").split(",").filter(Boolean);
                var show = tags.indexOf(active) !== -1;
                card.style.display = show ? "" : "none";
                if (show) visible++;
            });
            if (status) {
                status.textContent = visible + " artigo(s) com a tag \u201c" + active + "\u201d";
            }
            document.querySelectorAll("[data-tag-filter]").forEach(function (link) {
                var isActive =
                    link.getAttribute("data-tag-filter") === active ||
                    (active === null && link.getAttribute("data-tag-filter") === "");
                link.removeAttribute("aria-current");
                if (isActive) link.setAttribute("aria-current", "true");
            });
        })();
    </script>
</BaseLayout>
