---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const activeTag = Astro.url.searchParams.get("tag");
const tagsOf = (p: (typeof allPosts)[number]): string[] => (p.data as { tags?: string[] }).tags ?? [];
const allTags = [...new Set(allPosts.flatMap((p) => tagsOf(p)))].sort();
const posts = activeTag ? allPosts.filter((p) => tagsOf(p).includes(activeTag)) : allPosts;
---

<BaseLayout
    title={`Blog | ${SITE_TITLE}`}
    description={SITE_DESCRIPTION}
>
    <div class="mx-auto w-full max-w-5xl px-4 lg:px-8">
        <section class="py-16 md:py-24">
            <p class="mb-6 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-primary">
                <span class="inline-block h-px w-10 bg-primary" aria-hidden="true"></span>
                Escritos
            </p>
            <h1 class="m-0 mb-6 font-display text-5xl font-extrabold tracking-tight md:text-7xl">
                Todos os artigos
            </h1>
            <p class="m-0 mb-10 max-w-xl text-lg leading-relaxed text-muted-foreground">
                Ensaios, tutoriais e explorações na interseção entre tecnologia,
                design e experiência humana.
            </p>
            <nav class="flex flex-wrap gap-2" aria-label="Filtrar por tag" data-tag-nav>
                <a
                    href="/blog"
                    data-tag-filter=""
                    data-tag-pill
                    class={`inline-flex items-center rounded-full border px-3.5 py-1.5 font-mono text-xs tracking-wide no-underline transition-colors duration-300 max-md:min-h-11 ${!activeTag ? "border-primary bg-primary text-primary-foreground" : "border-input text-muted-foreground hover:border-primary hover:text-primary"}`}
                >
                    Todos
                </a>
                {allTags.map((tag) => (
                    <a
                        href={`/blog?tag=${encodeURIComponent(tag)}`}
                        data-tag-filter={tag}
                        data-tag-pill
                        class={`inline-flex items-center rounded-full border px-3.5 py-1.5 font-mono text-xs tracking-wide no-underline transition-colors duration-300 max-md:min-h-11 ${activeTag === tag ? "border-primary bg-primary text-primary-foreground" : "border-input text-muted-foreground hover:border-primary hover:text-primary"}`}
                        aria-current={activeTag === tag ? "true" : undefined}
                    >
                        {tag}
                    </a>
                ))}
            </nav>
        </section>

        <section class="mb-4">
            <div class="flex flex-col gap-4 border-b border-border pb-5 sm:flex-row sm:items-center sm:justify-between">
                <p class="m-0 text-sm text-muted-foreground" data-tag-status role="status" aria-live="polite">{posts.length === 1 ? "1 artigo para explorar" : `${posts.length} artigos para explorar`}</p>
                <label class="flex items-center gap-2 text-sm text-muted-foreground" data-search-box>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <span class="sr-only">Buscar artigos</span>
                    <input
                        type="search"
                        data-search-input
                        placeholder="Buscar um artigo..."
                        autocomplete="off"
                        class="w-48 border-0 bg-transparent p-0 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-0"
                    />
                </label>
            </div>
        </section>

        <section class="mb-28">
            <ol class="m-0 flex list-none flex-col p-0" data-posts-grid>
                {posts.map((post, i) => (
                    <li
                        data-post-card
                        data-post-tags={tagsOf(post).join(",")}
                        data-search-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
                    >
                        <a
                            href={`/blog/${post.id}/`}
                            class="group grid grid-cols-[auto_1fr] items-baseline gap-5 border-b border-dashed border-border py-6 no-underline transition-colors hover:bg-accent/40 sm:grid-cols-[auto_auto_1fr_auto] sm:items-center sm:px-3"
                        >
                            <span class="font-mono text-sm tabular-nums text-muted-foreground">{String(i + 1).padStart(3, "0")}</span>
                            {post.data.heroImage && (
                                <div class="hidden h-16 w-28 shrink-0 overflow-hidden rounded-sm border border-border bg-muted sm:block">
                                    <Image
                                        width={224}
                                        height={126}
                                        src={post.data.heroImage}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        class="h-full w-full object-cover"
                                    />
                                </div>
                            )}
                            <div class="flex min-w-0 flex-col gap-1.5">
                                <h2 class="m-0 truncate text-lg font-semibold leading-snug tracking-tight transition-colors group-hover:text-primary md:text-xl">
                                    {post.data.title}
                                </h2>
                                <p class="m-0 line-clamp-1 max-w-2xl text-sm text-muted-foreground">{post.data.description}</p>
                                {tagsOf(post).length > 0 && (
                                    <div class="mt-1 flex flex-wrap gap-1.5">
                                        {tagsOf(post).map((tag: string) => (
                                            <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[0.68rem] tracking-wide text-muted-foreground">{tag}</span>
                                        ))}
                                    </div>
                                )}
                            </div>
                            <div class="max-sm:col-span-2 max-sm:mt-1 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                                <FormattedDate date={post.data.pubDate} compact />
                            </div>
                        </a>
                    </li>
                ))}
            </ol>
        </section>
    </div>

    <script is:inline defer src="/scripts/blog-filters.js"></script>
</BaseLayout>
