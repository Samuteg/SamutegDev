---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...recentPosts] = allPosts;
const recentGrid = recentPosts.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="home-container">
        <!-- ── Hero Section (centered, editorial) ── -->
        <section class="hero fade-in-up">
            <p class="label-caps hero-label">Bem-vindo ao {SITE_TITLE}</p>
            <h1 class="display-lg hero-title">
                Explorando a <span class="text-accent">fronteira digital</span> através de código e criatividade.
            </h1>
            <p class="body-lg hero-subtitle">{SITE_DESCRIPTION}</p>
        </section>

        <!-- ── Featured Post ── -->
        {
            featured && (
                <section class="featured-section fade-in-up delay-1">
                    <div class="section-row">
                        <h2 class="headline-md">Destaque</h2>
                        <div class="section-rule" />
                    </div>

                    <a href={`/blog/${featured.id}/`} class="featured-card glass-card glow-hover">
                        <div class="featured-image">
                            {featured.data.heroImage && (
                                <Image
                                    width={800}
                                    height={600}
                                    src={featured.data.heroImage}
                                    alt=""
                                    loading="eager"
                                    decoding="async"
                                    class="featured-img"
                                />
                            )}
                        </div>
                        <div class="featured-content">
                            <div class="post-meta-row">
                                <span class="label-caps text-accent">Artigo</span>
                                <span class="label-caps meta-dot">•</span>
                                <span class="label-caps">
                                    <FormattedDate date={featured.data.pubDate} compact />
                                </span>
                            </div>
                            <h3 class="headline-md featured-title">{featured.data.title}</h3>
                            <p class="featured-desc">{featured.data.description}</p>
                            <div class="author-row">
                                <div class="author-avatar">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="label-caps author-name">{AUTHOR}</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </section>
            )
        }

        <!-- ── Recent Posts Grid ── -->
        <section class="recent-section fade-in-up delay-2">
            <div class="section-row">
                <h2 class="headline-md">Artigos recentes</h2>
                <a href="/blog" class="label-caps view-all">Ver todos →</a>
            </div>

            <div class="posts-grid">
                {
                    recentGrid.map((post) => (
                        <a href={`/blog/${post.id}/`} class="post-card glass-card glow-hover">
                            <div class="post-card-image">
                                {post.data.heroImage && (
                                    <Image
                                        width={600}
                                        height={400}
                                        src={post.data.heroImage}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        class="post-card-img"
                                    />
                                )}
                            </div>
                            <div class="post-card-body">
                                <div class="post-meta-row">
                                    <span class="label-caps text-tertiary">Artigo</span>
                                    <span class="label-caps meta-dot">•</span>
                                    <span class="label-caps">
                                        <FormattedDate date={post.data.pubDate} compact />
                                    </span>
                                </div>
                                <h3 class="headline-sm post-card-title">{post.data.title}</h3>
                                <p class="post-card-desc">{post.data.description}</p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </section>

        <!-- ── Newsletter Section ── -->
        <section class="newsletter-section fade-in-up delay-3">
            <div class="newsletter-card glass-card glow-hover">
                <svg class="newsletter-icon" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
                <h2 class="headline-md">Fique por dentro</h2>
                <p class="body-lg newsletter-desc">
                    Receba uma notificação quando eu publicar novos artigos. Sem spam, cancele quando quiser.
                </p>
                <form
                    class="newsletter-form"
                    action="https://formspree.io/f/mgojzqob"
                    method="POST"
                >
                    <input type="hidden" name="_subject" value="Nova inscrição na newsletter" />
                    <input type="checkbox" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none !important; position:absolute; left:-9999px;" />
                    <input
                        type="email"
                        name="email"
                        class="newsletter-input"
                        placeholder="seu@email.com"
                        required
                        aria-label="Email"
                    />
                    <button type="submit" class="btn-pill btn-pill-primary newsletter-submit">
                        Inscrever
                    </button>
                </form>
            </div>
        </section>
    </div>

    <style>
        .home-container {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding: 0 2.5rem;
        }

        /* ── Hero (centered editorial) ── */
        .hero {
            text-align: center;
            padding: 5rem 0;
            margin-bottom: 8rem;
            max-width: 48rem;
            margin-left: auto;
            margin-right: auto;
        }
        .hero-label {
            color: var(--accent-color);
            margin-bottom: 1rem;
        }
        .hero-title {
            margin: 0 0 2rem 0;
        }
        .text-accent { color: var(--accent-color); }
        .text-tertiary { color: var(--accent-tertiary); }
        .hero-subtitle {
            color: var(--text-muted);
            margin: 0;
        }

        /* ── Section rows ── */
        .featured-section,
        .recent-section {
            margin-bottom: 8rem;
        }
        .section-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .section-row h2 {
            margin: 0;
        }
        .section-rule {
            flex: 1;
            height: 4px;
            background: var(--accent-color);
            border-radius: 9999px;
            max-width: 4rem;
        }
        .view-all {
            color: var(--accent-color);
            text-decoration: none;
            transition: color var(--transition-fast);
            white-space: nowrap;
        }
        .view-all:hover {
            color: var(--accent-hover);
        }

        .post-meta-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        .meta-dot {
            color: var(--text-muted);
            opacity: 0.5;
        }

        /* ── Featured card ── */
        .featured-card {
            display: grid;
            grid-template-columns: 1fr;
            border-radius: var(--border-radius-xl);
            overflow: hidden;
            text-decoration: none;
            color: inherit;
        }
        .featured-image {
            aspect-ratio: 16 / 9;
            overflow: hidden;
            background: var(--bg-subtle);
        }
        .featured-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: none;
            border-radius: 0;
            transition: transform 0.7s ease;
        }
        .featured-card:hover .featured-img {
            transform: scale(1.05);
        }
        .featured-content {
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .featured-title {
            margin: 0 0 1rem 0;
            transition: color var(--transition-fast);
        }
        .featured-card:hover .featured-title {
            color: var(--accent-color);
        }
        .featured-desc {
            color: var(--text-muted);
            margin: 0 0 1.5rem 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .author-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .author-avatar {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 9999px;
            background: var(--accent-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-color);
            flex-shrink: 0;
        }
        .author-name {
            color: var(--text-color);
            margin: 0;
        }

        /* ── Recent posts grid ── */
        .posts-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
            align-items: stretch;
        }
        .post-card {
            border-radius: var(--border-radius-xl);
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .post-card-image {
            aspect-ratio: 16 / 9;
            overflow: hidden;
            background: var(--bg-subtle);
        }
        .post-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: none;
            border-radius: 0;
            transition: transform 0.7s ease;
        }
        .post-card:hover .post-card-img {
            transform: scale(1.05);
        }
        .post-card-body {
            padding: 1.5rem;
        }
        .post-card-title {
            margin: 0 0 0.75rem 0;
            transition: color var(--transition-fast);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .post-card:hover .post-card-title {
            color: var(--accent-color);
        }
        .post-card-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* ── Newsletter ── */
        .newsletter-section {
            margin-bottom: 4rem;
        }
        .newsletter-card {
            border-radius: var(--border-radius-xl);
            padding: 2rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .newsletter-icon {
            color: var(--accent-color);
            margin-bottom: 1.5rem;
        }
        .newsletter-card h2 {
            margin: 0 0 1rem 0;
        }
        .newsletter-desc {
            color: var(--text-muted);
            max-width: 32rem;
            margin: 0 0 2rem 0;
        }
        .newsletter-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
            max-width: 28rem;
        }
        .newsletter-input {
            flex: 1;
            padding: 0.75rem 1rem;
            border-radius: var(--border-radius-md);
            background: var(--bg-subtle);
            border: 1px solid var(--glass-border);
            color: var(--text-color);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            transition: border-color var(--transition-fast);
        }
        .newsletter-input:focus {
            outline: none;
            border-color: var(--accent-color);
        }
        .newsletter-submit {
            white-space: nowrap;
        }

        /* ── Responsive ── */
        @media (min-width: 768px) {
            .posts-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .newsletter-form {
                flex-direction: row;
            }
            .newsletter-card {
                padding: 3rem;
            }
        }

        @media (min-width: 1024px) {
            .featured-card {
                grid-template-columns: 1fr 1fr;
            }
            .featured-image {
                aspect-ratio: auto;
                min-height: 100%;
            }
            .featured-content {
                padding: 3rem;
            }
            .posts-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 767px) {
            .home-container {
                padding: 0 1rem;
            }
            .hero {
                padding: 3rem 0;
                margin-bottom: 4rem;
            }
            .featured-section,
            .recent-section {
                margin-bottom: 4rem;
            }
        }
    </style>
</BaseLayout>
