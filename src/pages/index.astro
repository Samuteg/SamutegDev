---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...recentPosts] = allPosts;
const recentGrid = recentPosts.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="mx-auto w-full max-w-7xl px-4 lg:px-8 xl:px-16">
        <section class="relative mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center md:py-32">
            <div
                class="pointer-events-none absolute left-1/2 top-1/3 -z-10 h-48 w-[22rem] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60 blur-3xl"
                style="background: radial-gradient(ellipse, color-mix(in srgb, var(--primary) 22%, transparent) 0%, transparent 70%)"
                aria-hidden="true"
            ></div>
            <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-primary shadow-sm">
                <span class="h-[7px] w-[7px] rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
                Engenharia & Desenvolvimento
            </span>
            <h1 class="m-0 font-display text-4xl font-extrabold leading-[1.15] tracking-tight md:text-6xl">
                Explorando a <span class="bg-gradient-to-br from-primary via-secondary-foreground to-tertiary bg-clip-text text-transparent">fronteira digital</span> através de código e criatividade.
            </h1>
            <p class="mb-9 mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{SITE_DESCRIPTION}</p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="/blog" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-medium text-primary-foreground no-underline shadow-sm transition-opacity hover:opacity-90">
                    Explorar artigos
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
                <a href="/about" class="inline-flex items-center gap-2 rounded-full border border-input bg-background px-6 py-3 text-sm font-medium no-underline shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
                    Sobre mim
                </a>
            </div>
        </section>

        {featured && (
            <section class="reveal flex flex-col gap-8 py-10 md:py-14">
                <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
                    <div class="flex grow flex-col items-start justify-center gap-4">
                        <span class="inline-flex h-7 items-center rounded-full border border-input px-3 py-1 text-sm font-normal">Destaque</span>
                        <h2 class="m-0 text-3xl font-semibold sm:text-5xl">Em destaque</h2>
                    </div>
                    <p class="max-w-xl text-base font-normal text-muted-foreground">
                        O artigo mais recente — tutoriais, ensaios e explorações na interseção entre tecnologia e experiência humana.
                    </p>
                </div>

                <a href={`/blog/${featured.id}/`} class="group flex flex-col gap-5 no-underline sm:col-span-2 lg:grid lg:grid-cols-2 lg:gap-8">
                    <div class="aspect-video w-full overflow-hidden rounded-xl border border-border bg-muted">
                        {featured.data.heroImage && (
                            <Image
                                width={800}
                                height={450}
                                src={featured.data.heroImage}
                                alt={featured.data.title}
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                class="h-full w-full object-cover object-center transition-transform duration-500 ease-in-out group-hover:scale-105"
                            />
                        )}
                    </div>
                    <div class="flex flex-col justify-center gap-4">
                        <div class="flex items-center gap-4 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                            <span class="text-primary">Artigo</span>
                            <span class="opacity-50">•</span>
                            <FormattedDate date={featured.data.pubDate} compact />
                        </div>
                        <h3 class="m-0 font-display text-2xl font-semibold leading-tight transition-colors group-hover:text-primary md:text-3xl">{featured.data.title}</h3>
                        <p class="m-0 line-clamp-3 text-muted-foreground">{featured.data.description}</p>
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary text-primary">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </div>
                            <p class="m-0 font-mono text-xs uppercase tracking-widest">{AUTHOR}</p>
                        </div>
                    </div>
                </a>
            </section>
        )}

        <section class="flex flex-col gap-8 py-10 md:py-14">
            <div class="flex items-center justify-between gap-4">
                <h2 class="m-0 font-display text-2xl font-bold tracking-tight md:text-3xl">Artigos recentes</h2>
                <a href="/blog" class="whitespace-nowrap font-mono text-xs uppercase tracking-widest text-primary no-underline transition-colors hover:opacity-80">Ver todos →</a>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {recentGrid.map((post) => (
                    <a href={`/blog/${post.id}/`} class="group flex h-full flex-col gap-5 no-underline">
                        <div class="aspect-video w-full overflow-hidden rounded-xl border border-border bg-muted">
                            {post.data.heroImage && (
                                <Image
                                    width={600}
                                    height={338}
                                    src={post.data.heroImage}
                                    alt={post.data.title}
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-in-out group-hover:scale-105"
                                />
                            )}
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center gap-4 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                                <span class="text-tertiary">Artigo</span>
                                <span class="opacity-50">•</span>
                                <FormattedDate date={post.data.pubDate} compact />
                            </div>
                            <h3 class="m-0 line-clamp-2 font-display text-xl font-semibold leading-snug transition-colors group-hover:text-primary">{post.data.title}</h3>
                            <p class="m-0 line-clamp-2 text-[0.95rem] text-muted-foreground">{post.data.description}</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        <section class="relative overflow-hidden py-12 md:py-16">
            <div class="relative overflow-hidden rounded-2xl border border-border bg-card px-6 py-10 text-center sm:px-10">
                <div class="pointer-events-none absolute -right-40 -top-32 opacity-60" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="500" height="430" fill="none">
                        <g filter="url(#nl-a)">
                            <path fill="url(#nl-b)" fill-rule="evenodd" d="m56 88 344 212-166 188L56 88Z" clip-rule="evenodd" />
                        </g>
                        <defs>
                            <linearGradient id="nl-b" x1="210.5" x2="210.5" y1="88" y2="467" gradientUnits="userSpaceOnUse">
                                <stop stop-color="var(--primary)" stop-opacity="0.35" />
                                <stop offset="1" stop-color="var(--primary)" stop-opacity="0" />
                            </linearGradient>
                            <filter id="nl-a" width="520" height="576" x="-32" y="0" color-interpolation-filters="sRGB" filterUnits="userSpaceOnUse">
                                <feFlood flood-opacity="0" result="BackgroundImageFix" />
                                <feBlend in="SourceGraphic" in2="BackgroundImageFix" result="shape" />
                                <feGaussianBlur result="effect1_foregroundBlur" stdDeviation="44" />
                            </filter>
                        </defs>
                    </svg>
                </div>
                <h2 class="mb-3 font-display text-xl font-extrabold tracking-tight md:text-2xl">Fique por dentro</h2>
                <p class="mx-auto mb-6 max-w-md text-muted-foreground">
                    Receba uma notificação quando eu publicar novos artigos. Sem spam, cancele quando quiser.
                </p>
                <form id="newsletter-form" class="mx-auto max-w-md" novalidate>
                    <input type="checkbox" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
                    <div class="flex gap-2 max-sm:flex-col">
                        <label for="newsletter-email" class="sr-only">Email para newsletter</label>
                        <input
                            id="newsletter-email"
                            name="email"
                            type="email"
                            required
                            placeholder="seu@email.com"
                            class="flex-1 rounded-md border border-input bg-background px-4 py-2.5 text-sm transition-colors placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                        />
                        <button
                            type="submit"
                            class="inline-flex items-center justify-center rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-50"
                        >
                            Inscrever
                        </button>
                    </div>
                    <p id="newsletter-status" class="mt-2 hidden text-xs" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>
    </div>
    <script is:inline defer src="/scripts/newsletter.js"></script>
    <style>
        /* Entrada suave do card em destaque (substitui a ilha React Reveal/framer-motion) */
        .reveal {
            animation: reveal-in 0.6s ease-out both;
        }
        @keyframes reveal-in {
            from {
                opacity: 0;
                transform: translateY(24px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .reveal {
                animation: none;
            }
        }
        /* Mini-spinner do botão da newsletter (feedback de loading) */
        .btn-loading::after {
            content: "";
            display: inline-block;
            width: 1em;
            height: 1em;
            margin-left: 0.5em;
            vertical-align: -0.15em;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 9999px;
            animation: nl-spin 0.75s linear infinite;
        }
        @keyframes nl-spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</BaseLayout>
