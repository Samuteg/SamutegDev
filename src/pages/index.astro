---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...recentPosts] = allPosts;
const recentGrid = recentPosts.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="mx-auto w-full max-w-6xl px-4 lg:px-8">
        <section class="flex flex-col items-start py-20 md:py-28">
            <p class="mb-8 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-primary">
                <span class="inline-block h-px w-10 bg-primary" aria-hidden="true"></span>
                Engenharia &amp; Desenvolvimento
            </p>
            <h1 class="m-0 max-w-4xl font-display text-5xl font-extrabold leading-[1.05] tracking-tight md:text-7xl">
                Explorando a fronteira digital através de <em class="not-italic text-primary underline decoration-border decoration-2 underline-offset-8">código</em> e criatividade.
            </h1>
            <p class="mb-10 mt-8 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl">{SITE_DESCRIPTION}</p>
            <div class="flex flex-wrap items-center gap-4">
                <a href="/blog" class="group inline-flex items-center gap-2 rounded-md bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground no-underline transition-colors hover:bg-accent hover:text-accent-foreground">
                    Explorar artigos
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
                <a href="/about" class="inline-flex items-center gap-2 rounded-md border border-input bg-transparent px-6 py-3 text-sm font-semibold no-underline transition-colors hover:border-foreground">
                    Sobre mim
                </a>
            </div>
        </section>

        {featured && (
            <section class="reveal flex flex-col gap-8 border-t border-border py-14 md:py-20">
                <div class="flex flex-col justify-between gap-4 border-b border-dashed border-border pb-6 sm:flex-row sm:items-end">
                    <h2 class="m-0 font-display text-2xl font-bold tracking-tight md:text-3xl">Em destaque</h2>
                    <p class="m-0 max-w-md text-sm font-normal text-muted-foreground">
                        O artigo mais recente — tutoriais, ensaios e explorações na interseção entre tecnologia e experiência humana.
                    </p>
                </div>

                <a href={`/blog/${featured.id}/`} class="group flex flex-col gap-6 no-underline lg:grid lg:grid-cols-[5fr_6fr] lg:gap-10">
                    <div class="aspect-video w-full overflow-hidden rounded-md border border-border bg-muted lg:aspect-auto lg:h-full">
                        {featured.data.heroImage && (
                            <Image
                                width={800}
                                height={450}
                                src={featured.data.heroImage}
                                alt={featured.data.title}
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                            />
                        )}
                    </div>
                    <div class="flex flex-col justify-center gap-4">
                        <div class="flex items-center gap-4 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                            <span class="text-primary">№ 001</span>
                            <span class="opacity-50">•</span>
                            <FormattedDate date={featured.data.pubDate} compact />
                        </div>
                        <h3 class="m-0 font-display text-3xl font-bold leading-tight tracking-tight transition-colors group-hover:text-primary md:text-4xl">{featured.data.title}</h3>
                        <p class="m-0 line-clamp-3 text-lg text-muted-foreground">{featured.data.description}</p>
                        <span class="mt-2 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-primary">
                            Ler artigo
                            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                        </span>
                    </div>
                </a>
            </section>
        )}

        <section class="flex flex-col gap-10 border-t border-border py-14 md:py-20">
            <div class="flex items-end justify-between gap-4 border-b border-dashed border-border pb-6">
                <h2 class="m-0 font-display text-2xl font-bold tracking-tight md:text-3xl">Artigos recentes</h2>
                <a href="/blog" class="whitespace-nowrap font-mono text-xs uppercase tracking-widest text-primary no-underline transition-opacity hover:opacity-70">Ver todos →</a>
            </div>

            <ol class="m-0 flex list-none flex-col p-0">
                {recentGrid.map((post, i) => (
                    <li>
                        <a href={`/blog/${post.id}/`} class="group grid grid-cols-[auto_1fr] items-baseline gap-6 border-b border-border py-7 no-underline transition-colors last:border-b-0 sm:grid-cols-[auto_auto_1fr_auto] sm:items-center">
                            <span class="font-mono text-sm tabular-nums text-muted-foreground">{String(i + 2).padStart(3, "0")}</span>
                            {post.data.heroImage && (
                                <div class="hidden h-14 w-24 shrink-0 overflow-hidden rounded-sm border border-border bg-muted sm:block">
                                    <Image
                                        width={192}
                                        height={108}
                                        src={post.data.heroImage}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        class="h-full w-full object-cover"
                                    />
                                </div>
                            )}
                            <div class="flex min-w-0 flex-col gap-1.5">
                                <h3 class="m-0 truncate text-lg font-semibold leading-snug tracking-tight transition-colors group-hover:text-primary md:text-xl">{post.data.title}</h3>
                                <p class="m-0 line-clamp-1 max-w-2xl text-sm text-muted-foreground">{post.data.description}</p>
                            </div>
                            <div class="max-sm:col-span-2 max-sm:mt-1 font-mono text-xs uppercase tracking-widest text-muted-foreground">
                                <FormattedDate date={post.data.pubDate} compact />
                            </div>
                        </a>
                    </li>
                ))}
            </ol>
        </section>

        <section class="border-t border-border py-14 md:py-20">
            <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-2">
                <div>
                    <h2 class="m-0 font-display text-2xl font-bold tracking-tight md:text-3xl">Fique por dentro</h2>
                    <p class="mb-0 mt-4 max-w-md text-muted-foreground">
                        Receba uma notificação quando eu publicar novos artigos. Sem spam, cancele quando quiser.
                    </p>
                </div>
                <form id="newsletter-form" class="w-full" novalidate>
                    <input type="checkbox" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
                    <div class="flex gap-3 max-sm:flex-col">
                        <label for="newsletter-email" class="sr-only">Email para newsletter</label>
                        <input
                            id="newsletter-email"
                            name="email"
                            type="email"
                            required
                            placeholder="seu@email.com"
                            class="flex-1 rounded-md border border-input bg-transparent px-4 py-3 text-sm transition-colors placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                        />
                        <button
                            type="submit"
                            class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-85 disabled:opacity-50"
                        >
                            Inscrever
                        </button>
                    </div>
                    <p id="newsletter-status" class="mt-2 hidden text-xs" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>
    </div>
    <script is:inline defer src="/scripts/newsletter.js"></script>
    <style>
        /* Entrada suave do card em destaque (substitui a ilha React Reveal/framer-motion) */
        .reveal {
            animation: reveal-in 0.6s ease-out both;
        }
        @keyframes reveal-in {
            from {
                opacity: 0;
                transform: translateY(24px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .reveal {
                animation: none;
            }
        }
        /* Mini-spinner do botão da newsletter (feedback de loading) */
        .btn-loading::after {
            content: "";
            display: inline-block;
            width: 1em;
            height: 1em;
            margin-left: 0.5em;
            vertical-align: -0.15em;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 9999px;
            animation: nl-spin 0.75s linear infinite;
        }
        @keyframes nl-spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</BaseLayout>
