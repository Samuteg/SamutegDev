---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
    title={`Página não encontrada | ${SITE_TITLE}`}
    description="Ops! A página que você procura não existe ou foi movida."
    index={false}
>
    <section class="mx-auto flex min-h-[70vh] w-full max-w-5xl flex-col items-start justify-center px-4 py-16 lg:px-8">
        <p class="mb-6 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-primary">
            <span class="inline-block h-px w-10 bg-primary" aria-hidden="true"></span>
            Erro 404
        </p>
        <p class="m-0 font-display text-7xl font-extrabold leading-none tracking-tight text-border md:text-9xl" aria-hidden="true">404</p>
        <h1 class="m-0 mt-4 font-display text-3xl font-extrabold tracking-tight md:text-5xl">
            Página não encontrada
        </h1>
        <p class="mb-10 mt-6 max-w-lg text-lg text-muted-foreground">
            Parece que você se perdeu na fronteira digital. A página que
            você procura não existe ou foi movida para outro endereço.
        </p>
        <div class="flex flex-wrap gap-4 max-sm:w-full max-sm:flex-col">
            <a href="/" class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground no-underline transition-opacity hover:opacity-85 max-sm:w-full">Voltar ao início</a>
            <a href="/blog" class="inline-flex items-center justify-center rounded-md border border-input bg-transparent px-6 py-3 text-sm font-semibold no-underline transition-colors hover:border-foreground max-sm:w-full">Ver artigos</a>
        </div>
    </section>
</BaseLayout>
