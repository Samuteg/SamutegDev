---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
    title={`Obrigado | ${SITE_TITLE}`}
    description="Obrigado pela sua mensagem!"
>
    <section class="flex min-h-[70vh] items-center justify-center px-6 py-8">
        <div class="flex max-w-md flex-col items-center rounded-3xl border border-border bg-card p-10 text-center md:p-12">
            <div class="mb-8 flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-full border border-border text-primary">
                <svg
                    class="h-8 w-8"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h1 class="m-0 mb-4 font-display text-2xl font-bold tracking-tight md:text-3xl">
                <span class="bg-gradient-to-br from-primary to-secondary-foreground bg-clip-text text-transparent">Mensagem enviada!</span>
            </h1>
            <p class="m-0 mb-8 text-lg text-muted-foreground">
                Obrigado pelo contato. Sua mensagem foi recebida e eu
                responderei em breve.
            </p>
            <a href="/" class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-mono text-xs uppercase tracking-widest text-primary-foreground no-underline transition-opacity hover:opacity-90">Voltar ao início</a>
        </div>
    </section>
</BaseLayout>
