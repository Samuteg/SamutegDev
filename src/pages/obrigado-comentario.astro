---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
    title={`Obrigado | ${SITE_TITLE}`}
    description="Obrigado pela sua mensagem!"
    hideScrollProgress={true}
>
    <section class="thank-you fade-in-up">
        <div class="thank-card glass-card glow-hover">
            <div class="icon-wrap">
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h1 class="headline-md">
                <span class="gradient-text">Mensagem enviada!</span>
            </h1>
            <p class="body-lg">
                Obrigado pelo contato. Sua mensagem foi recebida e eu
                responderei em breve.
            </p>
            <a href="/" class="btn-pill btn-pill-primary">Voltar ao início</a>
        </div>
    </section>

    <style>
        .thank-you {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: 2rem 1.5rem;
        }
        .thank-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 3rem 2.5rem;
            border-radius: var(--border-radius-xl);
            max-width: 30rem;
        }
        .icon-wrap {
            width: 4.5rem;
            height: 4.5rem;
            border-radius: 9999px;
            border: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            color: var(--accent-color);
        }
        .icon {
            width: 2rem;
            height: 2rem;
        }
        .thank-card h1 {
            margin: 0 0 1rem 0;
        }
        .gradient-text {
            background: linear-gradient(
                135deg,
                var(--accent-color),
                var(--accent-secondary)
            );
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
        }
        .thank-card p {
            color: var(--text-muted);
            margin: 0 0 2rem 0;
        }
    </style>
</BaseLayout>
